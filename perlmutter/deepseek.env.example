# Non-secret experiment settings. The API key is a separate, chmod-600 file.
unset TESTER_BASE_URL
export AZURE_OPENAI_BASE_URL=https://ishaan-oai.services.ai.azure.com/openai/v1
export AZURE_OPENAI_API_VERSION=''
export TESTER_PROVIDER=deepseek
export TESTER_MODEL=DeepSeek-V4-Flash
export TESTER_THINKING=enabled
export TESTER_REASONING_EFFORT=high
export TESTER_MAX_TOKENS=65536
export CONTAINER_CLI=podman-hpc
export PYTHONUNBUFFERED=1
